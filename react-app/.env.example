# ── Site Configuration ──────────────────────────────────────────────────────
# Set these in your Vercel project settings under Environment Variables
# https://vercel.com/docs/concepts/projects/environment-variables

# Your live domain (no trailing slash)
VITE_SITE_URL=https://thedrawingboard.studio

# Studio / brand name
VITE_SITE_NAME=The Drawing Board

# Company legal name
VITE_COMPANY_NAME=The Drawing Board Studio

# Default meta description for pages that don't specify one
VITE_DEFAULT_DESCRIPTION=The Drawing Board — a strategy-first design studio crafting brand identities, packaging systems, and digital products for ambitious founders.

# Comma-separated default keywords
VITE_DEFAULT_KEYWORDS=brand identity design, packaging design, web design, UI UX design, branding agency India

# Author / studio name shown in meta author tag
VITE_AUTHOR=The Drawing Board

# ── Social / OG Image ────────────────────────────────────────────────────────
# Absolute URL to the default Open Graph image (1200×630px recommended)
VITE_DEFAULT_OG_IMAGE=https://thedrawingboard.studio/home_preview.png

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-3FHFNH8BZ7

# Google Tag Manager Container ID — leave blank to disable
# Format: GTM-XXXXXXX
VITE_GTM_CONTAINER_ID=

# Google Search Console HTML meta tag verification value
# Format: the content="..." value only (not the full tag)
VITE_GOOGLE_SITE_VERIFICATION=

# ── Social Handles ───────────────────────────────────────────────────────────
# Twitter / X handle (with @)
VITE_TWITTER_HANDLE=@thedrawingboard

# Instagram handle (without @)
VITE_INSTAGRAM_HANDLE=thedrawingboard.studio
